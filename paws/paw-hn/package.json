{
  "name": "@openvole/paw-hn",
  "version": "0.1.0",
  "description": "Hacker News reader for OpenVole — live front page, stories & threads via the public HN API, with an embedded dashboard panel",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@openvole/paw-sdk": "^3.2.1",
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "vole-paw.json",
    "README.md",
    "panel.html"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openvole/pawhub",
    "directory": "paws/paw-hn"
  },
  "keywords": [
    "openvole",
    "paw",
    "hacker-news",
    "hn",
    "reader",
    "panel"
  ],
  "peerDependencies": {
    "@openvole/paw-sdk": ">=2.0.0"
  },
  "private": true
}
